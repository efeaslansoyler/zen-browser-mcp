{
  "name": "zen-browser-mcp",
  "version": "0.1.0",
  "description": "Let AI agents use your Zen (and other Firefox-based) browser with real input, your own sessions, and a live status island.",
  "type": "module",
  "bin": {
    "zen-browser-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "browser",
    "skills",
    "README.md",
    "README.tr.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "eslint . && node scripts/check-comments.ts",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efeaslansoyler/zen-browser-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/efeaslansoyler/zen-browser-mcp/issues"
  },
  "homepage": "https://github.com/efeaslansoyler/zen-browser-mcp#readme",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axe-core": "4.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "zen-browser",
    "firefox",
    "librewolf",
    "floorp",
    "waterfox",
    "gecko",
    "browser-automation",
    "model-context-protocol"
  ]
}
