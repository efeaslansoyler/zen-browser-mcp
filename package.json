  "bin": {
    "zen-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "browser",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efeaslansoyler/zen-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/efeaslansoyler/zen-mcp/issues"
  },
  "homepage": "https://github.com/efeaslansoyler/zen-mcp#readme",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axe-core": "4.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "zen-browser",
